{
  "compilerOptions": {
    /* File layout */
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"],

    /* Runtime */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* Output */
    "sourceMap": true,

    /* Type safety */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* ESM hygiene */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    /* Misc */
    "skipLibCheck": true
  },
  "include": ["src", "prisma.config.ts"]
}
